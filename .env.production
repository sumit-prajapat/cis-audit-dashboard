# =====================================================
# CIS AUDIT DASHBOARD - Production Environment
# =====================================================
# Use this for production deployments on Render.com
# Add these variables in Render Dashboard → Environment

# Database - Render PostgreSQL
# Get this from: Render Dashboard → Your Database → Internal Database URL
DATABASE_URL=postgresql://cisadmin:xxxxx@dpg-xxxxx-a:5432/cisaudit

# Security - Generated secure key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=FbbFxR1_YrgyplekvXE4YDg99UxWKYSHiez2gAC_IGo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_DAYS=30

# Password & Security Policies
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Frontend & CORS (Production)
FRONTEND_URL=https://cis-audit-dashboard.vercel.app
ALLOWED_ORIGINS=https://cis-audit-dashboard.vercel.app,https://cis-audit-dashboard-git-main-sumit-prajapats-projects.vercel.app

# Cookies (Production - secure)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Email Service (Optional - Resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_VERIFICATION_REQUIRED=false

# Stripe Billing (Optional)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
PYTHON_VERSION=3.11.0

# =====================================================
# FRONTEND ENVIRONMENT (Vercel)
# =====================================================
# Add this ONE variable in Vercel Dashboard:

# Backend API URL
# VITE_API_URL=https://cis-audit-api.onrender.com

# =====================================================
# NOTES
# =====================================================
# 1. NEVER commit this file with real credentials!
# 2. Use Render/Vercel dashboards to set environment variables
# 3. Generate new SECRET_KEY for production
# 4. Use Internal Database URL from Render (not external)
# 5. Update ALLOWED_ORIGINS with all your frontend URLs
