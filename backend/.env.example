# =====================================================
# CIS AUDIT DASHBOARD - Environment Configuration
# Copy this file to .env and fill in your values
# =====================================================

# ────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ────────────────────────────────────────────────────

# For Production (Render PostgreSQL - use INTERNAL URL)
DATABASE_URL=postgresql://cisadmin:password@host.region.render.com:5432/cisdb

# For Local Development (SQLite)
# DATABASE_URL=sqlite:///./cis_audit.db

# ────────────────────────────────────────────────────
# SECURITY CONFIGURATION
# ────────────────────────────────────────────────────

# Generate with: python backend/generate_secret.py
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-change-this

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_DAYS=30

# Password Security
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ────────────────────────────────────────────────────
# CORS & FRONTEND CONFIGURATION
# ────────────────────────────────────────────────────

# Your frontend URL (Vercel deployment)
FRONTEND_URL=https://cis-audit-dashboard.vercel.app

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://cis-audit-dashboard.vercel.app,http://localhost:5173

# ────────────────────────────────────────────────────
# COOKIE CONFIGURATION
# ────────────────────────────────────────────────────

# Use secure cookies (HTTPS only) - Set to true in production
COOKIE_SECURE=true

# Cookie SameSite policy
COOKIE_SAMESITE=lax

# ────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ────────────────────────────────────────────────────

# Environment: development, staging, or production
APP_ENV=production

# API Host and Port (for local development)
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────
# EMAIL CONFIGURATION (Optional)
# ────────────────────────────────────────────────────

# Resend API key for sending emails
RESEND_API_KEY=re_your_resend_api_key_here

# Require email verification for new accounts
EMAIL_VERIFICATION_REQUIRED=false

# ────────────────────────────────────────────────────
# STRIPE BILLING CONFIGURATION (Optional)
# ────────────────────────────────────────────────────

# Get these from: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_STARTER=price_starter_monthly_id
STRIPE_PRICE_GROWTH=price_growth_monthly_id
STRIPE_PRICE_TEAM=price_team_monthly_id

# ────────────────────────────────────────────────────
# AGENT CONFIGURATION
# ────────────────────────────────────────────────────

# Backend API URL for scanner agent
CIS_API_URL=http://localhost:8000

# ────────────────────────────────────────────────────
# NOTES
# ────────────────────────────────────────────────────

# 1. DATABASE_URL:
#    - Production: Use Render PostgreSQL INTERNAL URL
#    - Development: Use SQLite for simplicity
#
# 2. SECRET_KEY:
#    - MUST be at least 32 characters
#    - Generate with: python backend/generate_secret.py
#    - NEVER commit the real key to git!
#
# 3. FRONTEND_URL:
#    - Update with your actual Vercel deployment URL
#    - Used for CORS configuration
#
# 4. COOKIE_SECURE:
#    - Set to true in production (requires HTTPS)
#    - Set to false for local development
#
# 5. Optional Services:
#    - Email (Resend): Only needed if sending verification/notification emails
#    - Billing (Stripe): Only needed if using paid subscription features
