# =====================================================
# CIS AUDIT DASHBOARD - Production Environment
# =====================================================
# CRITICAL: Do NOT commit this file with real values!
# Copy to .env and fill with actual credentials

# Database - Use managed PostgreSQL (AWS RDS, Azure Database, etc.)
DB_USER=cisadmin
DB_PASSWORD=<STRONG_PASSWORD_HERE>
DB_NAME=cisdb_production
DB_HOST=<your-db-host>.rds.amazonaws.com
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# Security - MUST CHANGE!
SECRET_KEY=<GENERATE_WITH_generate_secret.py>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_DAYS=30

# Password Policies
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS - Set to your actual frontend domain
FRONTEND_URL=https://app.yourdomain.com
ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# Cookies - Enable secure cookies in production
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Email - Resend.com API
RESEND_API_KEY=re_<your_resend_api_key>
EMAIL_VERIFICATION_REQUIRED=true

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_<your_stripe_secret_key>
STRIPE_WEBHOOK_SECRET=whsec_<your_webhook_secret>
STRIPE_PUBLISHABLE_KEY=pk_live_<your_publishable_key>

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_STARTER=price_<starter_monthly_id>
STRIPE_PRICE_GROWTH=price_<growth_monthly_id>
STRIPE_PRICE_TEAM=price_<team_monthly_id>

# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Agent Configuration
CIS_API_URL=https://api.yourdomain.com

# Optional: Slack/Teams Webhooks
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Optional: Monitoring
SENTRY_DSN=
DATADOG_API_KEY=
