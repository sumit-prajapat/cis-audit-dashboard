# =====================================================
# CIS AUDIT DASHBOARD - Environment Configuration
# =====================================================

# Database Configuration
DB_USER=cisadmin
DB_PASSWORD=supersecretpassword
DB_NAME=cisdb
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://cisadmin:supersecretpassword@db:5432/cisdb

# For local development (not using Docker):
# DATABASE_URL=postgresql://cisadmin:supersecretpassword@localhost:5432/cisdb

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production-please-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_DAYS=30

# Password & Security Policies
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Email (Optional - Resend API for notifications)
RESEND_API_KEY=
EMAIL_VERIFICATION_REQUIRED=false

# Stripe Billing (Get from Stripe Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_GROWTH=price_growth_monthly
STRIPE_PRICE_TEAM=price_team_monthly

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Agent Configuration
CIS_API_URL=http://localhost:8000
